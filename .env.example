# Source: opennews, pib, json, or fixture
NEWS_SOURCE=opennews
NEWS_SOURCE_URL=
OPEN_NEWS_URL=https://nlko2jkif0.execute-api.ap-south-1.amazonaws.com/prod/news/latest
NEWS_LIMIT=11

# Gemini text enrichment (free tier available for eligible text models).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini image generation is paid-only. GEMINI_API_KEY is reused if this is blank.
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_ASPECT_RATIO=4:5
GEMINI_IMAGE_SIZE=1K

# Free daily image generation through Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=6
IMAGE_PROVIDER=cloudflare

BRAND_NAME=UPSC BRIEF
OUTPUT_DIR=output
PORT=8787
